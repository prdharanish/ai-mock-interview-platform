# Frontend environment variables
# Copy this file to .env and fill in the values.

# NOTE: VITE_ prefixed variables are bundled into the browser JS bundle and are
# publicly visible to anyone who inspects the page. Do NOT put secret API keys here.
# The Judge0 API key lives in server/.env (JUDGE0_API_KEY) and is proxied securely
# through the backend /api/execute route — no key needed here.

# Optional: override the backend API base URL (defaults to /api via Vite proxy in dev).
# Set this only for production deployments pointing at a remote backend.
# VITE_API_BASE_URL=https://your-production-backend.com/api
