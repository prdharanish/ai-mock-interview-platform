PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/interview-platform
JWT_SECRET=your_super_secret_jwt_key_change_this

# Gemini Flash (current GA model). Override LLM_MODEL to swap without code changes.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash

# Judge0 (Public CE instance)
# We are using https://ce.judge0.com which does not require an API key by default.
# JUDGE0_API_KEY=your_rapidapi_key_here  # (Optional: Only if you switch back to RapidAPI)
